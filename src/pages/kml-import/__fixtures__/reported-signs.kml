    <Placemark>
      <name>CA - Jesus Saves (Springfield)</name>
      <description><![CDATA["Reported 03/02/25 by ASP (XX) via GSV dated Aug 2023.<br>Last checked 01/10/26; Nov 2025 GSV.<br>34.0001, -118.0001<br>Yellow sign nailed to a utility pole on the south side of Main St across from Oak Rd. Not visible on the Mar 2022 GSV image.<br>Updated 11/14/25: As of GSV dated Aug 2025, the snipe sign was still there."<br><img src="https://lh3.example.test/photo-a" height="200" width="auto" />]]></description>
      <styleUrl>#icon-1670-0288D1-normal</styleUrl>
      <ExtendedData>
        <Data name="gx_media_links">
          <value><![CDATA[https://lh3.example.test/photo-a https://lh3.example.test/photo-b]]></value>
        </Data>
      </ExtendedData>
      <Point>
