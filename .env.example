# Frontend (Vite) — copy to .env and fill in. These are public by design:
# the anon key is safe to expose because Postgres RLS is the security
# boundary (docs/adr/0001-rls-sole-security-boundary.md).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: public app base URL used to build share links.
# Defaults to the page origin at runtime when unset.
# VITE_APP_BASE_URL=https://your-site.example/
